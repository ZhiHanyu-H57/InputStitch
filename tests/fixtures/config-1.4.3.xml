<?xml version="1.0"?>
<MacroConfig xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <FormatVersion>3</FormatVersion>
  <Macros>
    <MacroDefinition>
      <Name>1.4.3 sequence / 顺序</Name>
      <Description>Legacy fixture</Description>
      <Enabled>true</Enabled>
      <Trigger>
        <Ctrl>true</Ctrl>
        <Shift>false</Shift>
        <Alt>true</Alt>
        <Win>false</Win>
        <Kind>Keyboard</Kind>
        <VirtualKey>119</VirtualKey>
        <Extended>false</Extended>
        <MatchExtended>false</MatchExtended>
        <GamepadControl>South</GamepadControl>
        <GamepadUserIndex>-1</GamepadUserIndex>
      </Trigger>
      <RunMode>Toggle</RunMode>
      <Infinite>false</Infinite>
      <RepeatCount>7</RepeatCount>
      <SuppressTrigger>false</SuppressTrigger>
      <MappingLayerId>custom-old</MappingLayerId>
      <Steps>
        <MacroStep>
          <Action>Down</Action>
          <Kind>Keyboard</Kind>
          <VirtualKey>65</VirtualKey>
          <ScanCode>30</ScanCode>
          <Extended>false</Extended>
          <GamepadControl>South</GamepadControl>
          <GamepadX>0</GamepadX>
          <GamepadY>100</GamepadY>
          <GamepadValue>100</GamepadValue>
          <HoldMs>25</HoldMs>
          <DelayMs>81</DelayMs>
          <RandomDelay>true</RandomDelay>
          <RandomDelayMinMs>40</RandomDelayMinMs>
          <RandomDelayMaxMs>120</RandomDelayMaxMs>
        </MacroStep>
        <MacroStep>
          <Action>Up</Action>
          <Kind>Keyboard</Kind>
          <VirtualKey>65</VirtualKey>
          <ScanCode>0</ScanCode>
          <Extended>false</Extended>
          <GamepadControl>South</GamepadControl>
          <GamepadX>0</GamepadX>
          <GamepadY>100</GamepadY>
          <GamepadValue>100</GamepadValue>
          <HoldMs>0</HoldMs>
          <DelayMs>13</DelayMs>
          <RandomDelay>false</RandomDelay>
          <RandomDelayMinMs>45</RandomDelayMinMs>
          <RandomDelayMaxMs>60</RandomDelayMaxMs>
        </MacroStep>
      </Steps>
    </MacroDefinition>
    <MacroDefinition>
      <Name>1.4.3 mouse hold</Name>
      <Description />
      <Enabled>true</Enabled>
      <Trigger>
        <Ctrl>false</Ctrl>
        <Shift>false</Shift>
        <Alt>false</Alt>
        <Win>false</Win>
        <Kind>MouseX1</Kind>
        <VirtualKey>119</VirtualKey>
        <Extended>false</Extended>
        <MatchExtended>false</MatchExtended>
        <GamepadControl>South</GamepadControl>
        <GamepadUserIndex>-1</GamepadUserIndex>
      </Trigger>
      <RunMode>Hold</RunMode>
      <Infinite>true</Infinite>
      <RepeatCount>1</RepeatCount>
      <SuppressTrigger>true</SuppressTrigger>
      <MappingLayerId>base</MappingLayerId>
      <Steps>
        <MacroStep>
          <Action>Press</Action>
          <Kind>Gamepad</Kind>
          <VirtualKey>65</VirtualKey>
          <ScanCode>0</ScanCode>
          <Extended>false</Extended>
          <GamepadControl>LeftStick</GamepadControl>
          <GamepadX>-32</GamepadX>
          <GamepadY>77</GamepadY>
          <GamepadValue>83</GamepadValue>
          <HoldMs>19</HoldMs>
          <DelayMs>31</DelayMs>
          <RandomDelay>false</RandomDelay>
          <RandomDelayMinMs>45</RandomDelayMinMs>
          <RandomDelayMaxMs>60</RandomDelayMaxMs>
        </MacroStep>
      </Steps>
    </MacroDefinition>
    <MacroDefinition>
      <Name>1.4.3 disabled</Name>
      <Description />
      <Enabled>false</Enabled>
      <Trigger>
        <Ctrl>false</Ctrl>
        <Shift>false</Shift>
        <Alt>false</Alt>
        <Win>false</Win>
        <Kind>Gamepad</Kind>
        <VirtualKey>119</VirtualKey>
        <Extended>false</Extended>
        <MatchExtended>false</MatchExtended>
        <GamepadControl>RightShoulder</GamepadControl>
        <GamepadUserIndex>2</GamepadUserIndex>
      </Trigger>
      <RunMode>Toggle</RunMode>
      <Infinite>false</Infinite>
      <RepeatCount>1</RepeatCount>
      <SuppressTrigger>true</SuppressTrigger>
      <MappingLayerId>base</MappingLayerId>
      <Steps>
        <MacroStep>
          <Action>Press</Action>
          <Kind>MouseRight</Kind>
          <VirtualKey>65</VirtualKey>
          <ScanCode>0</ScanCode>
          <Extended>false</Extended>
          <GamepadControl>South</GamepadControl>
          <GamepadX>0</GamepadX>
          <GamepadY>100</GamepadY>
          <GamepadValue>100</GamepadValue>
          <HoldMs>45</HoldMs>
          <DelayMs>123</DelayMs>
          <RandomDelay>false</RandomDelay>
          <RandomDelayMinMs>45</RandomDelayMinMs>
          <RandomDelayMaxMs>60</RandomDelayMaxMs>
        </MacroStep>
      </Steps>
    </MacroDefinition>
  </Macros>
  <UseScanCodeInput>false</UseScanCodeInput>
  <ActivateTargetWindowOnUiRun>true</ActivateTargetWindowOnUiRun>
  <UiRunStartDelayMs>470</UiRunStartDelayMs>
  <KeepWindowTopMost>true</KeepWindowTopMost>
  <PauseMacroInRiskyUi>false</PauseMacroInRiskyUi>
  <PanicTrigger>
    <Ctrl>true</Ctrl>
    <Shift>false</Shift>
    <Alt>true</Alt>
    <Win>false</Win>
    <Kind>Keyboard</Kind>
    <VirtualKey>122</VirtualKey>
    <Extended>false</Extended>
    <MatchExtended>false</MatchExtended>
    <GamepadControl>South</GamepadControl>
    <GamepadUserIndex>-1</GamepadUserIndex>
  </PanicTrigger>
  <AutoSwitchProfiles>true</AutoSwitchProfiles>
  <MinimizeToTray>false</MinimizeToTray>
  <Language>en-US</Language>
  <UpdateMode>Manual</UpdateMode>
  <GamepadDeviceType>None</GamepadDeviceType>
  <GamepadRouterEnabled>false</GamepadRouterEnabled>
  <IdleGamepad>
    <Enabled>false</Enabled>
    <IdleSeconds>83</IdleSeconds>
    <HoldMilliseconds>211</HoldMilliseconds>
    <Pulse>
      <Kind>Gamepad</Kind>
      <VirtualKey>65</VirtualKey>
      <ScanCode>0</ScanCode>
      <Extended>false</Extended>
      <GamepadControl>RightStick</GamepadControl>
      <GamepadX>25</GamepadX>
      <GamepadY>-75</GamepadY>
      <GamepadValue>100</GamepadValue>
    </Pulse>
    <TargetProcessName>ExampleIdle</TargetProcessName>
    <TargetWindowTitle>Idle example</TargetWindowTitle>
    <TargetWindowClass>IdleClass</TargetWindowClass>
    <TargetScopeInitialized>true</TargetScopeInitialized>
  </IdleGamepad>
  <HasSeenWelcome>true</HasSeenWelcome>
  <LastShownReleaseSummaryVersion>1.4.3</LastShownReleaseSummaryVersion>
  <TargetProcessName>ExampleGame</TargetProcessName>
  <TargetWindowTitle>Example game window</TargetWindowTitle>
  <TargetWindowClass>ExampleClass</TargetWindowClass>
  <MappingLayers>
    <MappingLayerDefinition>
      <Id>base</Id>
      <Name>My base</Name>
      <IsBase>true</IsBase>
    </MappingLayerDefinition>
    <MappingLayerDefinition>
      <Id>custom-old</Id>
      <Name>Old custom layer</Name>
      <IsBase>false</IsBase>
      <SwitchTrigger>
        <Ctrl>true</Ctrl>
        <Shift>false</Shift>
        <Alt>false</Alt>
        <Win>false</Win>
        <Kind>Keyboard</Kind>
        <VirtualKey>120</VirtualKey>
        <Extended>false</Extended>
        <MatchExtended>false</MatchExtended>
        <GamepadControl>South</GamepadControl>
        <GamepadUserIndex>-1</GamepadUserIndex>
      </SwitchTrigger>
    </MappingLayerDefinition>
